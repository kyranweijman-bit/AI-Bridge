# Rename this file to ".env" and fill in your real values.
# Never commit the real ".env" to GitHub - it's already listed in .gitignore.
# (Deploying to Streamlit Community Cloud instead? These same keys go into
# the app's "Secrets" settings there, not into a .env file on that platform.)

ANTHROPIC_API_KEY=your-claude-key-here
OPENAI_API_KEY=your-openai-key-here

# Check current model names before running:
# Claude:  https://docs.claude.com/en/docs/about-claude/models
# OpenAI:  https://platform.openai.com/docs/models
CLAUDE_MODEL=your-claude-model-name-here
OPENAI_MODEL=your-openai-model-name-here

# Required - the app's password gate. Pick anything; this is what you and
# anyone you share the site with will type to get in.
APP_PASSWORD=choose-a-password-here

# Required - the Postgres connection string for permanent storage (chats,
# memory, usage log, etc). Get this from Supabase: Project Settings ->
# Database -> Connection string -> "Session pooler" (not "Direct connection" -
# Streamlit Cloud needs the pooler). Looks like:
# postgresql://postgres.xxxxxxx:[YOUR-PASSWORD]@aws-0-xxxx.pooler.supabase.com:5432/postgres
DATABASE_URL=your-supabase-connection-string-here

# Optional - only needed if you also want original uploaded files (not just
# their extracted text) kept in Supabase Storage. Without these two, "Edit my
# file" and everything else still works - it just keeps original file bytes
# in the database's files.original_bytes column instead of Storage.
# Project Settings -> API -> Project URL / service_role key. Also create a
# Storage bucket named "files" if you set these.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional - only needed if you run api.py (the separate webhook/API script -
# NOT used by the Streamlit app itself). Pick any long random string.
API_KEY=
